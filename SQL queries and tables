#? recognized as a string for medical specialty - need to transform data from ? entered for unknown values to NULL for all unknown values to not skew analysis results

#Clean up ? values for unknown information - NULL 
SELECT * REPLACE (
  NULLIF(gender, '?') AS gender,
NULLIF(race, '?') AS race,
NULLIF(weight, '?') AS weight, NULLIF(payer_code, '?') AS payer_code,
NULLIF(medical_specialty, '?') AS medical_specialty
)
 FROM `lunar-prism-510122-n5.healthcare_analysis_clean.diabetic_patients_clean`

