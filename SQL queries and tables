    medical_specialty,
    COUNT(*) AS encounters
FROM `lunar-prism-510122-n5`.healthcare_analysis.diabetic_patients
WHERE medical_specialty IS NOT NULL
GROUP BY medical_specialty
ORDER BY encounters DESC;
