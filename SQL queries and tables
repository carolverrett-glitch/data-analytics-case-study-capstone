#Compare readmission rates according to prior inpatient visits.
SELECT
    number_inpatient AS prior_inpatient_visits,
    COUNT(*) AS total_encounters,
    COUNTIF(readmitted = '<30') AS readmitted_under_30,
    ROUND(
        SAFE_DIVIDE(
            COUNTIF(readmitted = '<30'),
            COUNT(*)
        ) * 100,
        2
    ) AS readmission_rate
FROM `lunar-prism-510122-n5.analysis_tables.clean_analysis_tables`
GROUP BY prior_inpatient_visits
ORDER BY prior_inpatient_visits;
